{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-unisonos.github.io/schemas/governed-memory.v1.schema.json",
  "title": "Unison governed memory v1",
  "oneOf": [
    {"$ref": "#/$defs/dataDomain"},
    {"$ref": "#/$defs/retrieval"},
    {"$ref": "#/$defs/derivedView"},
    {"$ref": "#/$defs/invalidationReceipt"},
    {"$ref": "#/$defs/contextPacket"},
    {"$ref": "#/$defs/taxonomySignal"},
    {"$ref": "#/$defs/taxonomyProposal"},
    {"$ref": "#/$defs/taxonomyDecision"},
    {"$ref": "#/$defs/taxonomyActivationReceipt"},
    {"$ref": "#/$defs/taxonomyProposalPreview"},
    {"$ref": "#/$defs/taxonomySecurityReview"},
    {"$ref": "#/$defs/taxonomyMigrationPreview"},
    {"$ref": "#/$defs/taxonomyMigrationCommand"},
    {"$ref": "#/$defs/taxonomyMigrationReceipt"},
    {"$ref": "#/$defs/taxonomyRollbackReceipt"},
    {"$ref": "#/$defs/derivedViewRebuildJob"},
    {"$ref": "#/$defs/embeddingMigrationPlan"}
  ],
  "$defs": {
    "domainId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "algorithm": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm_id", "algorithm_version"],
      "properties": {
        "algorithm_id": {"type": "string"}, "algorithm_version": {"type": "string"},
        "model_id": {"type": ["string", "null"]}, "model_revision": {"type": ["string", "null"]}
      }
    },
    "dataDomain": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "domain_id", "display_name", "description", "origin", "status", "separate_key_required", "created_at"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "domain_id": {"$ref": "#/$defs/domainId"},
        "display_name": {"type": "string"}, "description": {"type": "string"},
        "parent_domain_id": {"oneOf": [{"$ref": "#/$defs/domainId"}, {"type": "null"}]},
        "origin": {"enum": ["system", "person", "usage", "update"]},
        "status": {"enum": ["proposed", "active", "deprecated"]},
        "separate_key_required": {"type": "boolean"}, "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "retrieval": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "space_ids", "data_domains", "purpose", "query", "token_budget", "audience", "allow_remote"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"},
        "space_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "data_domains": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/domainId"}},
        "purpose": {"type": "string", "minLength": 1}, "query": {"type": "string"},
        "token_budget": {"type": "integer", "minimum": 1, "maximum": 131072},
        "audience": {"type": "array", "items": {"type": "string"}}, "allow_remote": {"type": "boolean"}
      }
    },
    "derivedView": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "view_id", "view_kind", "source_record_id", "source_revision", "space_id", "data_domains", "index_namespace", "algorithm", "created_at"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "view_id": {"type": "string"},
        "view_kind": {"enum": ["embedding", "summary", "cache", "graph-edge"]},
        "source_record_id": {"type": "string"}, "source_revision": {"type": "integer", "minimum": 1},
        "space_id": {"type": "string"}, "data_domains": {"type": "array", "items": {"$ref": "#/$defs/domainId"}},
        "index_namespace": {"type": "string"}, "algorithm": {"$ref": "#/$defs/algorithm"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "invalidationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "receipt_id", "view_id", "source_record_id", "source_revision", "reason", "invalidated_at"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "receipt_id": {"type": "string"},
        "view_id": {"type": "string"}, "source_record_id": {"type": "string"},
        "source_revision": {"type": "integer", "minimum": 1},
        "reason": {"enum": ["correction", "deletion", "retention-expiry", "membership-revocation", "key-rotation"]},
        "invalidated_at": {"type": "string", "format": "date-time"}
      }
    },
    "taxonomyLevel": {"enum": ["tag", "subdomain", "security-domain"]},
    "taxonomySignal": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "signal_id", "candidate_domain_id", "current_domain_ids", "signal_type", "suggested_level", "observed_at"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "signal_id": {"type": "string"},
        "candidate_domain_id": {"$ref": "#/$defs/domainId"},
        "current_domain_ids": {"type": "array", "items": {"$ref": "#/$defs/domainId"}},
        "signal_type": {"enum": ["repeated-request", "classification-correction", "distinct-audience", "policy-friction", "retention-friction", "sharing-friction"]},
        "suggested_level": {"$ref": "#/$defs/taxonomyLevel"},
        "observed_at": {"type": "string", "format": "date-time"},
        "source_reference": {"type": ["string", "null"]}
      }
    },
    "taxonomyProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "proposal_id", "candidate", "proposed_level", "evidence_count", "distinct_days", "evidence_types", "rationale", "benefits", "affected_record_ids", "status", "requires_explicit_approval", "created_at"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "proposal_id": {"type": "string"},
        "candidate": {"$ref": "#/$defs/dataDomain"}, "proposed_level": {"$ref": "#/$defs/taxonomyLevel"},
        "evidence_count": {"type": "integer", "minimum": 1}, "distinct_days": {"type": "integer", "minimum": 1},
        "evidence_types": {"type": "array", "items": {"type": "string"}}, "rationale": {"type": "string"},
        "benefits": {"type": "array", "items": {"type": "string"}}, "affected_record_ids": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["pending", "approved", "declined", "deferred", "withdrawn"]},
        "requires_explicit_approval": {"const": true}, "created_at": {"type": "string", "format": "date-time"},
        "cooldown_until": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "taxonomyDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "decision_id", "proposal_id", "decision", "migration_scope", "selected_record_ids", "explicit_confirmation", "decided_at"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "decision_id": {"type": "string"}, "proposal_id": {"type": "string"},
        "decision": {"enum": ["approve", "decline", "defer"]}, "migration_scope": {"enum": ["none", "selected", "all"]},
        "selected_record_ids": {"type": "array", "items": {"type": "string"}}, "explicit_confirmation": {"type": "boolean"},
        "reason": {"type": ["string", "null"]}, "decided_at": {"type": "string", "format": "date-time"}
      }
    },
    "taxonomyActivationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "receipt_id", "proposal_id", "decision_id", "domain", "migration_scope", "migration_status", "migrated_record_ids", "activated_at"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "receipt_id": {"type": "string"}, "proposal_id": {"type": "string"},
        "decision_id": {"type": "string"}, "domain": {"$ref": "#/$defs/dataDomain"},
        "migration_scope": {"enum": ["none", "selected", "all"]}, "migration_status": {"enum": ["not-started", "partial", "complete"]},
        "migrated_record_ids": {"type": "array", "items": {"type": "string"}}, "activated_at": {"type": "string", "format": "date-time"}
      }
    },
    "taxonomyProposalPreview": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "proposal_id", "prompt", "summary", "why_now", "would_change", "would_not_change", "choices", "requires_security_review", "generated_at"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "proposal_id": {"type": "string"}, "prompt": {"type": "string"}, "summary": {"type": "string"},
        "why_now": {"type": "array", "items": {"type": "string"}}, "would_change": {"type": "array", "items": {"type": "string"}},
        "would_not_change": {"type": "array", "items": {"type": "string"}}, "choices": {"type": "array", "items": {"enum": ["approve", "defer", "decline"]}},
        "requires_security_review": {"type": "boolean"}, "generated_at": {"type": "string", "format": "date-time"}
      }
    },
    "taxonomySecurityReview": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "review_id", "proposal_id", "decision", "policy_version", "separate_key_boundary", "retention_reviewed", "sharing_reviewed", "disclosure_reviewed", "rationale", "reviewed_at"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "review_id": {"type": "string"}, "proposal_id": {"type": "string"}, "decision": {"enum": ["approve", "deny"]},
        "policy_version": {"type": "string"}, "separate_key_boundary": {"type": "boolean"}, "retention_reviewed": {"type": "boolean"},
        "sharing_reviewed": {"type": "boolean"}, "disclosure_reviewed": {"type": "boolean"}, "rationale": {"type": "string"}, "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "taxonomyMigrationPreview": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "preview_id", "proposal_id", "domain_id", "source_domain_ids", "record_revisions", "classification_change", "key_boundary_change", "reversible", "created_at", "expires_at", "confirmation_digest"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "preview_id": {"type": "string"}, "proposal_id": {"type": "string"}, "domain_id": {"$ref": "#/$defs/domainId"},
        "source_domain_ids": {"type": "array", "items": {"$ref": "#/$defs/domainId"}}, "record_revisions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "classification_change": {"type": "string"}, "key_boundary_change": {"type": "string"}, "reversible": {"const": true},
        "created_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "confirmation_digest": {"type": "string"}
      }
    },
    "taxonomyMigrationCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "preview_id", "confirmation_digest", "explicit_confirmation"],
      "properties": {"contract_version": {"const": "unison.memory.v1"}, "preview_id": {"type": "string"}, "confirmation_digest": {"type": "string"}, "explicit_confirmation": {"const": true}}
    },
    "taxonomyMigrationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "migration_id", "preview_id", "proposal_id", "domain_id", "migrated_record_ids", "status", "rollback_until", "completed_at"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "migration_id": {"type": "string"}, "preview_id": {"type": "string"}, "proposal_id": {"type": "string"}, "domain_id": {"$ref": "#/$defs/domainId"},
        "migrated_record_ids": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["complete", "rolled-back"]},
        "rollback_until": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "taxonomyRollbackReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "rollback_id", "migration_id", "restored_record_ids", "rolled_back_at"],
      "properties": {"contract_version": {"const": "unison.memory.v1"}, "rollback_id": {"type": "string"}, "migration_id": {"type": "string"}, "restored_record_ids": {"type": "array", "items": {"type": "string"}}, "rolled_back_at": {"type": "string", "format": "date-time"}}
    },
    "derivedViewRebuildJob": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "job_id", "owner_person_id", "source_record_id", "source_revision", "view_kind", "target_algorithm", "target_namespace", "state", "attempts", "created_at"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "job_id": {"type": "string"}, "owner_person_id": {"type": "string"}, "source_record_id": {"type": "string"},
        "source_revision": {"type": "integer", "minimum": 1}, "view_kind": {"enum": ["embedding", "summary", "cache", "graph-edge"]},
        "target_algorithm": {"$ref": "#/$defs/algorithm"}, "target_namespace": {"type": "string"},
        "state": {"enum": ["pending", "running", "complete", "failed", "cancelled"]}, "attempts": {"type": "integer", "minimum": 0}, "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "embeddingMigrationPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "migration_id", "owner_person_id", "source_algorithm", "target_algorithm", "source_namespace", "target_namespace", "strategy", "state", "total_jobs", "completed_jobs", "created_at"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "migration_id": {"type": "string"}, "owner_person_id": {"type": "string"},
        "source_algorithm": {"$ref": "#/$defs/algorithm"}, "target_algorithm": {"$ref": "#/$defs/algorithm"},
        "source_namespace": {"type": "string"}, "target_namespace": {"type": "string"}, "strategy": {"const": "dual-index-rebuild-and-swap"},
        "state": {"enum": ["rebuilding", "ready", "cutover", "rolled-back"]}, "total_jobs": {"type": "integer", "minimum": 0},
        "completed_jobs": {"type": "integer", "minimum": 0}, "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "contextPacket": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "purpose", "space_ids", "data_domains", "token_budget", "records", "citations", "contains_inferences", "disclosure_allowed", "remote_allowed"],
      "properties": {
        "contract_version": {"const": "unison.memory.v1"}, "purpose": {"type": "string"},
        "space_ids": {"type": "array", "items": {"type": "string"}},
        "data_domains": {"type": "array", "items": {"$ref": "#/$defs/domainId"}},
        "token_budget": {"type": "integer"}, "records": {"type": "array", "items": {"type": "object"}},
        "citations": {"type": "array", "items": {"type": "string"}},
        "contains_inferences": {"type": "boolean"}, "disclosure_allowed": {"type": "boolean"},
        "remote_allowed": {"type": "boolean"}
      }
    }
  }
}

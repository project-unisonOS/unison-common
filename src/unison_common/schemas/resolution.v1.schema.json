{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-unisonos.github.io/schemas/resolution.v1.json",
  "title": "Unison resolution and determinization contracts",
  "oneOf": [
    {"$ref": "#/$defs/ResolutionAttempt"},
    {"$ref": "#/$defs/ResolutionReceipt"},
    {"$ref": "#/$defs/DeterminizationCandidate"},
    {"$ref": "#/$defs/ResolutionPilotSignal"},
    {"$ref": "#/$defs/ModalityAdapterManifest"},
    {"$ref": "#/$defs/PilotEnrollment"},
    {"$ref": "#/$defs/PilotReviewDecision"},
    {"$ref": "#/$defs/HeadlessInteractionSession"},
    {"$ref": "#/$defs/CandidateCanaryRecord"}
  ],
  "$defs": {
    "ResolutionAttempt": {
      "type": "object",
      "required": ["schema_version", "attempt_id", "owner_person_id", "assistant_instance_id", "purpose", "risk", "requested_result_class", "authorized_space_ids", "authorized_domain_ids", "budget", "routes", "structural_fingerprint"],
      "properties": {"schema_version": {"const": "resolution-attempt.v1"}, "attempt_id": {"type": "string"}, "owner_person_id": {"type": "string"}, "assistant_instance_id": {"type": "string"}, "purpose": {"type": "string"}, "risk": {"enum": ["low", "medium", "high", "critical"]}, "requested_result_class": {"type": "string"}, "authorized_space_ids": {"type": "array", "items": {"type": "string"}}, "authorized_domain_ids": {"type": "array", "items": {"type": "string"}}, "budget": {"type": "object"}, "routes": {"type": "array", "minItems": 1}, "structural_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "ResolutionReceipt": {
      "type": "object", "required": ["schema_version", "receipt_id", "attempt_id", "outcome", "selected_route_ids"],
      "properties": {"schema_version": {"const": "resolution-receipt.v1"}, "receipt_id": {"type": "string"}, "attempt_id": {"type": "string"}, "outcome": {"enum": ["complete", "partial", "blocked", "cancelled"]}, "selected_route_ids": {"type": "array", "items": {"type": "string"}}}
    },
    "DeterminizationCandidate": {
      "type": "object", "required": ["schema_version", "candidate_id", "scope", "candidate_kind", "structural_fingerprint", "evidence_attempt_ids", "invariant_steps", "parameter_schema", "authority_requirements", "privacy_requirements", "modality_requirements", "failure_modes", "expected_benefit"],
      "properties": {"schema_version": {"const": "determinization-candidate.v1"}, "candidate_id": {"type": "string"}, "scope": {"enum": ["person-local", "household", "contribution"]}, "candidate_kind": {"type": "string"}, "structural_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "evidence_attempt_ids": {"type": "array", "minItems": 2, "uniqueItems": true}, "invariant_steps": {"type": "array", "minItems": 1}, "parameter_schema": {"type": "object"}, "authority_requirements": {"type": "array"}, "privacy_requirements": {"type": "array"}, "modality_requirements": {"type": "array"}, "failure_modes": {"type": "array"}, "expected_benefit": {"type": "string"}}
    },
    "ResolutionPilotSignal": {
      "type": "object", "required": ["schema_version", "signal_id", "attempt_id", "participant_id", "opted_in", "usefulness", "outcome", "elapsed_seconds", "interaction_turns", "clarification_count", "correction_count"],
      "properties": {"schema_version": {"const": "resolution-pilot-signal.v1"}, "signal_id": {"type": "string"}, "attempt_id": {"type": "string"}, "participant_id": {"type": "string"}, "opted_in": {"const": true}, "usefulness": {"enum": ["useful", "partly-useful", "not-useful"]}, "outcome": {"enum": ["complete", "partial", "blocked", "cancelled"]}, "elapsed_seconds": {"type": "integer", "minimum": 0, "maximum": 86400}, "interaction_turns": {"type": "integer", "minimum": 1}, "clarification_count": {"type": "integer", "minimum": 0}, "correction_count": {"type": "integer", "minimum": 0}, "boundary_incident": {"type": "boolean", "default": false}}
    },
    "ModalityAdapterManifest": {
      "type": "object", "required": ["schema_version", "adapter_id", "modality", "input_supported", "output_supported", "sem_versions", "expression_versions", "capability_ids", "package_digest", "signer_id"],
      "properties": {"schema_version": {"const": "modality-adapter.v1"}, "adapter_id": {"type": "string"}, "modality": {"type": "string"}, "input_supported": {"type": "boolean"}, "output_supported": {"type": "boolean"}, "sem_versions": {"type": "array", "minItems": 1}, "expression_versions": {"type": "array", "minItems": 1}, "capability_ids": {"type": "array"}, "package_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "signer_id": {"type": "string"}}
    },
    "PilotEnrollment": {
      "type": "object", "required": ["schema_version", "enrollment_id", "owner_person_id", "consent_grant_id", "scopes", "retention_days"],
      "properties": {"schema_version": {"const": "resolution-pilot-enrollment.v1"}, "enrollment_id": {"type": "string"}, "owner_person_id": {"type": "string"}, "consent_grant_id": {"type": "string", "minLength": 1}, "scopes": {"type": "array", "minItems": 1}, "retention_days": {"type": "integer", "minimum": 1, "maximum": 365}, "status": {"enum": ["active", "revoked", "deleted"]}, "telemetry_enabled": {"type": "boolean"}}
    },
    "PilotReviewDecision": {
      "type": "object", "required": ["schema_version", "review_id", "owner_person_id", "reviewer_id", "attempts", "candidate_suggestions", "boundary_incidents", "decision", "reason"],
      "properties": {"schema_version": {"const": "resolution-pilot-review.v1"}, "review_id": {"type": "string"}, "owner_person_id": {"type": "string"}, "reviewer_id": {"type": "string"}, "attempts": {"type": "integer", "minimum": 0}, "candidate_suggestions": {"type": "integer", "minimum": 0}, "boundary_incidents": {"type": "integer", "minimum": 0}, "decision": {"enum": ["continue", "adjust", "pause", "stop"]}, "reason": {"type": "string"}}
    },
    "HeadlessInteractionSession": {
      "type": "object", "required": ["schema_version", "session_id", "owner_person_id", "client_id", "transport", "input_modalities", "output_modalities", "reconnect_token_digest", "expires_at"],
      "properties": {"schema_version": {"const": "headless-interaction-session.v1"}, "session_id": {"type": "string"}, "owner_person_id": {"type": "string"}, "client_id": {"type": "string"}, "transport": {"enum": ["local", "lan", "tailscale", "relay"]}, "input_modalities": {"type": "array", "minItems": 1}, "output_modalities": {"type": "array", "minItems": 1}, "state": {"enum": ["active", "interrupted", "resumable", "closed", "revoked"]}, "reconnect_token_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "expires_at": {"type": "string", "format": "date-time"}}
    },
    "CandidateCanaryRecord": {
      "type": "object", "required": ["schema_version", "canary_id", "candidate_id", "owner_person_id", "package_digest", "synthetic", "authority_ids", "outcome", "prior_route_id"],
      "properties": {"schema_version": {"const": "determinization-canary.v1"}, "canary_id": {"type": "string"}, "candidate_id": {"type": "string"}, "owner_person_id": {"type": "string"}, "package_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "synthetic": {"const": true}, "authority_ids": {"type": "array"}, "outcome": {"enum": ["passed", "failed", "revoked", "rolled-back"]}, "prior_route_id": {"type": "string"}, "rollback_receipt_id": {"type": ["string", "null"]}}
    }
  }
}
